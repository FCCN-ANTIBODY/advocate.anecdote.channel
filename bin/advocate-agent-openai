#!/usr/bin/env bash
# The second reference adapter: any OpenAI-compatible /chat/completions.
#
# ONE adapter, and it is the wildcard. OpenAI, Azure, OpenRouter, Together, Groq, vLLM,
# llama.cpp's server, LM Studio and Ollama all speak this request shape — so a LOCAL model is a
# `url:`, not a fork. See BACKEND.md.
#
# It exists as much to prove the seam as to be used. Until there were two, "any command honouring
# this contract can stand behind ADVOCATE_AGENT_CMD" was a claim nobody had tested, and a contract
# with one implementation is a habit.
#
#   bin/advocate-agent-openai --available   exit 0 iff it could run a session now
#   bin/advocate-agent-openai               stdin: {method, seat, range, current}
#                                           stdout: {position, complaints, asks, session}
#
#   ADVOCATE_API_URL   default https://api.openai.com/v1/chat/completions
#   ADVOCATE_MODEL     default gpt-4o
#   ADVOCATE_AGENT_KEY / OPENAI_API_KEY   the credential. DELIBERATELY OPTIONAL: a local server
#                      usually wants none, and a backend that needs no credential is the
#                      strongest configuration available — a job holding no secret cannot leak
#                      one. ADVOCATE_KEY_ENV names a different variable to read.
set -euo pipefail

url="${ADVOCATE_API_URL:-https://api.openai.com/v1/chat/completions}"
model="${ADVOCATE_MODEL:-gpt-4o}"

key_env="${ADVOCATE_KEY_ENV-ADVOCATE_AGENT_KEY}"
api_key=""
[ -n "$key_env" ] && api_key="$(printenv "$key_env" 2>/dev/null || true)"
[ -n "$api_key" ] || api_key="${OPENAI_API_KEY:-}"

# A key for the wrong vendor is visible for free, and saying so costs one line instead of a
# call and a confusing 401. Same spirit as the Anthropic adapter's workspace-id check.
case "$api_key" in
  sk-ant-*)
    echo "advocate-agent-openai: that credential is an ANTHROPIC key (sk-ant-…) and this adapter" >&2
    echo "advocate-agent-openai:   speaks the OpenAI chat-completions API. Either declare" >&2
    echo "advocate-agent-openai:   'backend: {kind: anthropic}' or supply a key for this endpoint." >&2
    exit 1 ;;
esac

# LOCALNESS IS THE POINT, so being able to run must not require a credential. What it requires is
# an endpoint that answers. A remote default with no key, though, is just a 401 waiting to happen
# — so that one case is called early rather than staged with a misleading reason.
is_local=false
case "$url" in http://localhost*|http://127.0.0.1*|http://0.0.0.0*|http://[::1]*|http://*.local*) is_local=true ;; esac

if [ "${1:-}" = "--available" ]; then
  if [ "$is_local" = true ]; then
    # Reachability is the real question for a local server; an unreachable one should stage the
    # session, not fake it.
    curl -sS -o /dev/null --max-time 5 "${url%/chat/completions}/models" 2>/dev/null && exit 0
    echo "advocate-agent-openai: nothing is answering at $url" >&2
    exit 1
  fi
  [ -n "$api_key" ] && exit 0
  echo "advocate-agent-openai: no credential (looked at ${key_env:-<none>}, OPENAI_API_KEY)" >&2
  exit 1
fi

in="$(cat)"

system='You are an advocate: a standing seat that speaks for one constituency about what it takes to KEEP A REPOSITORY RUNNING for the people who depend on it. You are not here for the correctness of the code (tests own that) or for the content it publishes. You hold no authority: you decide nothing, you merge nothing, and every output is a position or a request that a human is free to decline.

The METHOD you are given is law. Follow it in order and obey its refusals — especially these: never widen scope beyond the repository in front of you; report a goal you cannot measure as unmeasured rather than estimating; write complaints in the constituency VOICE as felt problems, never as proposed fixes; label every complaint source as simulated, relayed or observed, where simulated is your own voice and is NOT testimony; try to close a complaint before adding one; never propose a new seat or adopt a concern nobody gave you; and never manufacture output because a schedule fired.

Reply with ONE JSON object and nothing else, with exactly these four string keys, each a whole markdown document: "position" (POSITION.md, rewritten entirely — it is a position, not a log), "complaints" (COMPLAINTS.md carried forward with your edits, preserving entries you are not changing), "asks" (ASKS.md, likewise), and "session" (the record of this run: the range you read, what changed, and what you deliberately did NOT say).'

user="$(printf '%s' "$in" | jq -r '
  "=== METHOD (law; follow in order) ===\n" + (.method // "") +
  "\n\n=== YOUR SEAT ===\n" + (.seat | tojson) +
  "\n\n=== WHAT MOVED ===\n" + (.range | tojson) +
  "\n\n=== YOUR CURRENT FILES ===\n--- POSITION.md ---\n" + (.current.position // "(none yet)") +
  "\n\n--- COMPLAINTS.md ---\n" + (.current.complaints // "(none yet)") +
  "\n\n--- ASKS.md ---\n" + (.current.asks // "(none yet)")')"

# Ask for the strictest thing that is portable. `json_object` is supported far more widely than
# `json_schema`, and servers that support neither ignore it — which is why the parse below is
# lenient and the refusal is strict.
body="$(jq -n --arg model "$model" --arg system "$system" --arg user "$user" '{
  model: $model,
  temperature: 0.3,
  response_format: { type: "json_object" },
  messages: [ { role: "system", content: $system }, { role: "user", content: $user } ]
}')"

# bash 3.2 — which is what macOS ships — treats "${arr[@]}" on an EMPTY array as an unbound
# variable under `set -u` and dies. Every optional-header array here is empty in the common
# case, so the guarded form is not a style preference: without it this adapter cannot run on a
# Mac at all. Ubuntu runners have bash 5 and never show it.
auth=()
[ -n "$api_key" ] && auth=(-H "authorization: Bearer $api_key")

response="$(printf '%s' "$body" | curl -sS "$url" -H "content-type: application/json" ${auth[@]+"${auth[@]}"} --data-binary @- )" || {
  echo "advocate-agent-openai: the endpoint did not answer" >&2; exit 1; }

if [ "$(printf '%s' "$response" | jq -r 'if .error then "y" else "n" end' 2>/dev/null || echo n)" = "y" ]; then
  echo "advocate-agent-openai: $(printf '%s' "$response" | jq -r '.error.message // "api error"')" >&2
  exit 1
fi

text="$(printf '%s' "$response" | jq -r '.choices[0].message.content // ""')"
[ -n "$text" ] || { echo "advocate-agent-openai: empty response" >&2; exit 1; }

# Lenient parse, strict refusal. A model that cannot be held to a schema will still wrap its JSON
# in a fenced block or introduce it with a sentence; that is worth surviving. What is NOT worth
# surviving is a partial object — the caller stages the work order and a human picks it up, which
# is a real outcome, and a half-written session is the failure the whole method is arranged
# against.
parsed="$(printf '%s' "$text" | sed -n '/```/,/```/p' | sed '1d;$d')"
[ -n "$parsed" ] || parsed="$text"

printf '%s' "$parsed" | jq -e 'if (.position and .complaints and .asks and .session) then . else empty end' \
  || { echo "advocate-agent-openai: no complete session in the response — staging instead of writing half of one" >&2; exit 1; }
